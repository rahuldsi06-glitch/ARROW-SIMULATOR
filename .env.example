# ================================================================
# Arrow Trading (arrow.trade) API Configuration
# ================================================================
# Obtain your App ID & App Secret from Arrow Profile -> Trading API
# Note: SEBI requires a registered static IP for trading API access.

# Application Credentials
ARROW_APP_ID=your_app_id_here
ARROW_APP_SECRET=your_app_secret_here

# Automated Login Credentials (TOTP)
ARROW_USER_ID=your_user_id_here
ARROW_PASSWORD=your_password_here
ARROW_TOTP_SECRET=your_totp_secret_here

# Alternatively, provide a pre-existing 24h JWT access token directly:
# ARROW_ACCESS_TOKEN=your_jwt_access_token_here

# API Base URL (Defaults to https://edge.arrow.trade)
ARROW_ROOT_URL=https://edge.arrow.trade

# Web Dashboard Settings
WEB_HOST=127.0.0.1
WEB_PORT=8000
